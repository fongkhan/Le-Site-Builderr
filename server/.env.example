# Port du serveur backend
PORT=4000

# Clés API pour les modèles d'IA (Remplissez celles que vous souhaitez utiliser)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Fournisseur par défaut si aucun n'est sélectionné dans l'interface (openai, anthropic ou gemini)
DEFAULT_PROVIDER=openai
# Modèles utilisés (facultatif) et délai maximal d'une réponse IA en millisecondes
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-opus-5-5
# GEMINI_MODEL=gemini-2.5-flash
# AI_TIMEOUT_MS=90000

# Quota journalier de générations IA par compte client (les admins sont illimités).
# Par défaut, il découle de l'OFFRE du compte (Découverte 10, Pro 50, Agence 200/jour) ;
# surchargeable par compte via le champ « aiDailyQuota » dans le panel Payload.
# Décommentez pour imposer une même limite à tous les comptes (0 = générations bloquées).
# AI_DAILY_QUOTA=10

# Configuration de la base de données Payload CMS (requise pour l'authentification).
# Ces valeurs correspondent au service « db » du docker-compose.yml à la racine :
# lancez « docker compose up -d » et cette URI fonctionne telle quelle.
# (PostgreSQL natif : adaptez l'utilisateur/mot de passe et créez la base metabuilder_db.)
DATABASE_URI=postgres://postgres:postgrespassword@127.0.0.1:5432/metabuilder_db

# Secret de signature des sessions Payload : générez une valeur aléatoire d'au moins 32 caractères
# (ex: openssl rand -hex 32). NE COMMITEZ JAMAIS la vraie valeur.
PAYLOAD_SECRET=changez-moi-valeur-aleatoire-32-caracteres-minimum

# Origine autorisée pour le frontend orchestrateur (CORS). Plusieurs valeurs séparées par des virgules.
FRONTEND_ORIGIN=http://localhost:5173

# Mots de passe des comptes de démonstration seedés (admin@admin.com / client@client.com).
# En PRODUCTION (NODE_ENV=production) : l'admin n'est créé qu'avec un SEED_ADMIN_PASSWORD
# d'au moins 12 caractères (jamais « password123 »), et le client de démonstration n'est
# pas créé (sauf SEED_DEMO_CLIENT=true).
SEED_ADMIN_PASSWORD=password123
SEED_CLIENT_PASSWORD=password123

# Envoi d'emails (réinitialisation de mot de passe). Si SMTP_HOST est vide,
# les emails sont écrits dans la console du serveur (mode développement).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@localhost

# --- Hébergement : où publier les sites construits ---
# simulation (défaut) : publication locale dans simulated_public_html, domaine et SSL fictifs.
# cpanel : publication RÉELLE sur un hébergement o2switch/cPanel via l'API (les 4
# variables CPANEL_* deviennent obligatoires — le serveur refuse de démarrer sinon).
HOSTING_DRIVER=simulation

# Jeton API cPanel : à créer dans cPanel ▸ Sécurité ▸ « Gérer les jetons d'API ».
# ⚠️ Ce jeton donne accès à votre hébergement : ne le committez jamais, ne le partagez pas.
CPANEL_HOST=                # ex : votre-serveur.o2switch.net
CPANEL_USER=                # votre identifiant cPanel
CPANEL_API_TOKEN=
CPANEL_ROOT_DOMAIN=         # domaine parent des sous-domaines créés, ex : mondomaine.fr
# CPANEL_PORT=2083          # port API cPanel (défaut)
# Adresse PUBLIQUE de ce serveur (API), utilisée par les sites publiés pour le formulaire
# de contact, la prise de RDV et les statistiques. Indispensable en mode cpanel.
# PUBLIC_API_URL=https://api.mondomaine.fr

# --- Exploitation (facultatif) ---
# Derrière un reverse-proxy : nombre de proxys de confiance (ex. 1) pour l'IP client.
# TRUST_PROXY=1
# Délai maximal d'un build Astro (ms) et nombre de versions conservées pour le rollback.
# BUILD_TIMEOUT_MS=600000
# DEPLOY_KEEP_RELEASES=3
# Sauvegardes automatiques du contenu des sites (archives dans backups/).
# BACKUP_ENABLED=true
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14
# Journal des requêtes API en production (toujours actif en développement).
# HTTP_DEBUG=true

# DANGER — Mode développement sans authentification : toutes les requêtes sont traitées
# comme un admin. À n'utiliser QUE en local sans base de données. Refusé en production.
DEV_NO_AUTH=false
