---
import Layout from '../../layouts/Layout.astro';
import { DEFAULT_LOCALE } from '../../lib/i18n.mjs';
import { getSiteContent, parseTags } from '../../lib/content';
import type { NavPage, Post } from '../../lib/content';
import { markdownToHtml } from '../../lib/markdown.mjs';
import { formatDate, isoDate } from '../../lib/format';
import { absoluteUrl, safeHttpUrl, withBase } from '../../lib/url';

// Une page par article publié. Le blog n'est pas localisé : menu de la langue par défaut.
export async function getStaticPaths() {
  const { posts, navByLocale, locales } = await getSiteContent();
  const nav = navByLocale[DEFAULT_LOCALE] || [];
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, nav, locales },
  }));
}

interface Props {
  post: Post;
  nav: NavPage[];
  locales: string[];
}
const { post, nav, locales } = Astro.props;

// Rendu du corps en mini-markdown (gras, listes, liens, titres), échappé et sûr.
const bodyHtml = markdownToHtml(post.body);
const tags = parseTags(post.tags);
const cover = safeHttpUrl(post.coverImage);
const published = formatDate(post.publishedAt);

// Données structurées Article (schema.org) : améliore l'affichage dans les moteurs.
// Image en URL absolue (exigée par schema.org/Google) : omise sans URL publique.
const siteName = process.env.PUBLIC_SITE_NAME || '';
const siteUrl = (process.env.PUBLIC_SITE_URL || '').replace(/\/+$/, '');
const coverAbsolute = cover ? absoluteUrl(cover, siteUrl) : '';
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  ...(post.excerpt ? { description: post.excerpt } : {}),
  ...(coverAbsolute ? { image: [coverAbsolute] } : {}),
  ...(isoDate(post.publishedAt) ? { datePublished: isoDate(post.publishedAt) } : {}),
  ...(tags.length ? { keywords: tags.join(', ') } : {}),
  ...(siteName ? { publisher: { '@type': 'Organization', name: siteName } } : {}),
};
---

<Layout
  title={post.title}
  description={post.excerpt}
  pages={nav}
  currentSlug="blog"
  locale={DEFAULT_LOCALE}
  locales={locales}
  image={cover}
  ogType="article"
  jsonLd={[articleLd]}
>
  <article class="post">
    <div class="container">
      <a class="post-back" href={withBase('/blog/')}>← Toutes les actualités</a>
      <h1>{post.title}</h1>
      {published && <time class="post-date" datetime={isoDate(post.publishedAt)}>{published}</time>}
      {tags.length > 0 && (
        <div class="post-tags">
          {tags.map((t) => <span class="post-tag">{t}</span>)}
        </div>
      )}
      {cover && <img class="post-cover" src={cover} alt="" />}
      <div class="post-body" set:html={bodyHtml} />
    </div>
  </article>
</Layout>

<style>
  .post {
    padding: 50px 20px 80px;
    background-color: var(--color-bg);
  }
  .container {
    max-width: 720px;
    margin: 0 auto;
  }
  .post-back {
    display: inline-block;
    margin-bottom: 20px;
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .post h1 {
    font-size: 2.4rem;
    margin: 0 0 10px 0;
  }
  .post-date {
    display: block;
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 14px;
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 24px;
  }
  .post-tag {
    font-size: 0.74rem;
    padding: 3px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-primary) 12%, transparent);
    color: var(--color-primary);
    font-weight: 600;
  }
  .post-cover {
    width: 100%;
    max-height: 420px;
    object-fit: cover;
    border-radius: var(--border-radius);
    margin-bottom: 30px;
  }
  .post-body :global(p) {
    font-size: 1.05rem;
    line-height: 1.75;
    color: #374151;
    margin: 0 0 20px 0;
  }
  .post-body :global(h2),
  .post-body :global(h3),
  .post-body :global(h4) {
    margin: 32px 0 12px 0;
    line-height: 1.3;
  }
  .post-body :global(ul) {
    margin: 0 0 20px 0;
    padding-left: 24px;
    color: #374151;
    line-height: 1.7;
  }
  .post-body :global(li) {
    margin-bottom: 6px;
  }
  .post-body :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
  }
  .post-body :global(strong) {
    color: var(--color-text);
  }
</style>
