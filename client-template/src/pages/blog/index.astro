---
import Layout from '../../layouts/Layout.astro';
import { DEFAULT_LOCALE } from '../../lib/i18n.mjs';
import { getSiteContent, parseTags } from '../../lib/content';
import { formatDate, isoDate } from '../../lib/format';
import { safeHttpUrl, withBase } from '../../lib/url';
import { siteImage } from '../../lib/images';

// Le blog n'est pas localisé : il est rattaché à la langue par défaut (menu de cette
// langue, sélecteur vers les accueils des autres langues).
const { posts, navByLocale, locales, media } = await getSiteContent();
const nav = navByLocale[DEFAULT_LOCALE] || [];
// Couverture dans un lien qui porte déjà le titre de l'article : alt vide conservé ;
// dimensions et variantes (srcset) pour les images de la médiathèque.
const cards = posts.map((post) => {
  const src = safeHttpUrl(post.coverImage);
  return {
    ...post,
    cover: src ? siteImage(src, media, { sizes: '(max-width: 700px) calc(100vw - 40px), 380px' }) : null,
    tagList: parseTags(post.tags),
  };
});
---

<Layout
  title="Actualités"
  description="Nos derniers articles et actualités."
  pages={nav}
  currentSlug="blog"
  locale={DEFAULT_LOCALE}
  locales={locales}
>
  <main id="contenu" tabindex="-1">
    <section class="blog-index">
      <div class="container">
        <h1>Actualités</h1>
        {cards.length === 0 ? (
          <p class="blog-empty">Aucun article pour le moment. Revenez bientôt !</p>
        ) : (
          <>
            {cards.length > 2 && (
              <div class="blog-search">
                <label class="blog-search-label" for="blog-q">Rechercher un article</label>
                <input type="search" id="blog-q" class="blog-search-input" placeholder="Mot-clé, thème…" autocomplete="off" />
                <p class="blog-noresult" role="status" aria-live="polite" hidden>Aucun article ne correspond à votre recherche.</p>
              </div>
            )}
            <div class="blog-grid">
              {cards.map((post) => (
                <a
                  class="blog-card"
                  href={withBase(`/blog/${post.slug}/`)}
                  data-search={`${post.title} ${post.excerpt || ''} ${post.tagList.join(' ')}`.toLowerCase()}
                >
                  {post.cover && (
                    <img class="blog-cover" src={post.cover.src} alt="" width={post.cover.width} height={post.cover.height} srcset={post.cover.srcset} sizes={post.cover.sizes} loading="lazy" decoding="async" />
                  )}
                  <div class="blog-card-body">
                    {formatDate(post.publishedAt) && <time class="blog-date" datetime={isoDate(post.publishedAt)}>{formatDate(post.publishedAt)}</time>}
                    <h2>{post.title}</h2>
                    {post.tagList.length > 0 && (
                      <div class="blog-tags">
                        {post.tagList.map((t) => <span class="blog-tag">{t}</span>)}
                      </div>
                    )}
                    {post.excerpt && <p class="blog-excerpt">{post.excerpt}</p>}
                    <span class="blog-more" aria-hidden="true">Lire l'article →</span>
                  </div>
                </a>
              ))}
            </div>
          </>
        )}
      </div>
    </section>
  </main>
</Layout>

<script>
  // Recherche interne : filtrage côté client (aucun appel réseau), insensible aux
  // accents et à la casse. Sans JavaScript, tous les articles restent visibles.
  (function () {
    const input = document.getElementById('blog-q') as HTMLInputElement | null;
    if (!input) return;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.blog-card'));
    const empty = document.querySelector<HTMLElement>('.blog-noresult');
    const fold = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();

    input.addEventListener('input', () => {
      const q = fold(input.value.trim());
      let visible = 0;
      for (const card of cards) {
        const hay = fold(card.dataset.search || '');
        const match = q === '' || hay.includes(q);
        card.hidden = !match;
        if (match) visible++;
      }
      if (empty) empty.hidden = visible > 0;
    });
  })();
</script>

<style>
  .blog-index {
    padding: 60px 20px 80px;
    background-color: var(--color-bg);
  }
  .container {
    max-width: 1100px;
    margin: 0 auto;
  }
  .blog-index h1 {
    font-size: 2.6rem;
    margin-bottom: 40px;
    text-align: center;
  }
  .blog-empty {
    text-align: center;
    opacity: 0.7;
  }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 26px;
  }
  .blog-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border-radius: var(--border-radius);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }
  .blog-cover {
    width: 100%;
    height: 190px;
    object-fit: cover;
  }
  .blog-card-body {
    padding: 22px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .blog-date {
    font-size: 0.78rem;
    color: var(--color-primary);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .blog-card-body h2 {
    font-size: 1.25rem;
    margin: 0;
  }
  .blog-excerpt {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    line-height: 1.55;
    margin: 0;
  }
  .blog-more {
    margin-top: 6px;
    font-weight: 600;
    color: var(--color-primary);
    font-size: 0.88rem;
  }
  .blog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .blog-search {
    max-width: 420px;
    margin: 0 auto 34px auto;
    text-align: left;
  }
  .blog-search-label {
    display: block;
    font-size: 0.82rem;
    opacity: 0.75;
    margin-bottom: 6px;
  }
  .blog-search-input {
    width: 100%;
    padding: 11px 14px;
    border: 1px solid color-mix(in srgb, var(--color-text) 20%, transparent);
    border-radius: var(--border-radius);
    font-family: var(--font-body), sans-serif;
    font-size: 1rem;
    background-color: #fff;
    color: #111;
  }
  .blog-noresult {
    margin: 12px 0 0 0;
    font-size: 0.9rem;
    opacity: 0.8;
  }
  .blog-card[hidden] {
    display: none;
  }
  .blog-tag {
    font-size: 0.72rem;
    padding: 2px 8px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-primary) 12%, transparent);
    color: var(--color-primary);
    font-weight: 600;
  }
</style>
