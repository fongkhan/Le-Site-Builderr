---
import Layout from '../../layouts/Layout.astro';
import { fetchNavPages, fetchPosts, buildNav, parseTags } from '../../lib/content';

const pages = await fetchNavPages();
const posts = await fetchPosts();
const nav = buildNav(pages, posts);

const fmtDate = (iso?: string | null) => {
  if (!iso) return '';
  const d = new Date(iso);
  return isNaN(d.getTime()) ? '' : d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
};
---

<Layout title="Actualités" description="Nos derniers articles et actualités." pages={nav} currentSlug="blog">
  <section class="blog-index">
    <div class="container">
      <h1>Actualités</h1>
      {posts.length === 0 ? (
        <p class="blog-empty">Aucun article pour le moment. Revenez bientôt !</p>
      ) : (
        <>
          {posts.length > 2 && (
            <div class="blog-search">
              <label class="blog-search-label" for="blog-q">Rechercher un article</label>
              <input type="search" id="blog-q" class="blog-search-input" placeholder="Mot-clé, thème…" autocomplete="off" />
              <p class="blog-noresult" role="status" aria-live="polite" hidden>Aucun article ne correspond à votre recherche.</p>
            </div>
          )}
          <div class="blog-grid">
            {posts.map((post) => (
              <a
                class="blog-card"
                href={`/blog/${post.slug}/`}
                data-search={`${post.title} ${post.excerpt || ''} ${parseTags(post.tags).join(' ')}`.toLowerCase()}
              >
                {post.coverImage && <img class="blog-cover" src={post.coverImage} alt={post.title} loading="lazy" />}
                <div class="blog-card-body">
                  {post.publishedAt && <time class="blog-date">{fmtDate(post.publishedAt)}</time>}
                  <h2>{post.title}</h2>
                  {parseTags(post.tags).length > 0 && (
                    <div class="blog-tags">
                      {parseTags(post.tags).map((t) => <span class="blog-tag">{t}</span>)}
                    </div>
                  )}
                  {post.excerpt && <p class="blog-excerpt">{post.excerpt}</p>}
                  <span class="blog-more">Lire l'article →</span>
                </div>
              </a>
            ))}
          </div>
        </>
      )}
    </div>
  </section>
</Layout>

<script>
  // Recherche interne : filtrage côté client (aucun appel réseau), insensible aux
  // accents et à la casse. Sans JavaScript, tous les articles restent visibles.
  (function () {
    const input = document.getElementById('blog-q') as HTMLInputElement | null;
    if (!input) return;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.blog-card'));
    const empty = document.querySelector<HTMLElement>('.blog-noresult');
    const fold = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();

    input.addEventListener('input', () => {
      const q = fold(input.value.trim());
      let visible = 0;
      for (const card of cards) {
        const hay = fold(card.dataset.search || '');
        const match = q === '' || hay.includes(q);
        card.hidden = !match;
        if (match) visible++;
      }
      if (empty) empty.hidden = visible > 0;
    });
  })();
</script>

<style>
  .blog-index {
    padding: 60px 20px 80px;
    background-color: var(--color-bg);
  }
  .container {
    max-width: 1100px;
    margin: 0 auto;
  }
  .blog-index h1 {
    font-size: 2.6rem;
    margin-bottom: 40px;
    text-align: center;
  }
  .blog-empty {
    text-align: center;
    opacity: 0.7;
  }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 26px;
  }
  .blog-card {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border-radius: var(--border-radius);
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.06);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }
  .blog-cover {
    width: 100%;
    height: 190px;
    object-fit: cover;
  }
  .blog-card-body {
    padding: 22px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .blog-date {
    font-size: 0.78rem;
    color: var(--color-primary);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .blog-card-body h2 {
    font-size: 1.25rem;
    margin: 0;
  }
  .blog-excerpt {
    color: #4b5563;
    font-size: 0.92rem;
    line-height: 1.55;
    margin: 0;
  }
  .blog-more {
    margin-top: 6px;
    font-weight: 600;
    color: var(--color-primary);
    font-size: 0.88rem;
  }
  .blog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .blog-search {
    max-width: 420px;
    margin: 0 auto 34px auto;
    text-align: left;
  }
  .blog-search-label {
    display: block;
    font-size: 0.82rem;
    opacity: 0.75;
    margin-bottom: 6px;
  }
  .blog-search-input {
    width: 100%;
    padding: 11px 14px;
    border: 1px solid color-mix(in srgb, var(--color-text) 20%, transparent);
    border-radius: var(--border-radius);
    font-family: var(--font-body), sans-serif;
    font-size: 1rem;
    background-color: #fff;
    color: #111;
  }
  .blog-noresult {
    margin: 12px 0 0 0;
    font-size: 0.9rem;
    opacity: 0.8;
  }
  .blog-card[hidden] {
    display: none;
  }
  .blog-tag {
    font-size: 0.72rem;
    padding: 2px 8px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-primary) 12%, transparent);
    color: var(--color-primary);
    font-weight: 600;
  }
</style>
