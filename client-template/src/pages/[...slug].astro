---
import Layout from '../layouts/Layout.astro';
import { DEFAULT_LOCALE, localePath, localeRouteParam } from '../lib/i18n.mjs';
import { getSiteContent, isDraftBuild } from '../lib/content';
import type { Block, NavPage, PageDoc } from '../lib/content';
import { localBusinessLd, faqPageLd } from '../lib/jsonld';
import { safeHttpUrl, withBase } from '../lib/url';
import Hero from '../components/blocks/Hero.astro';
import Features from '../components/blocks/Features.astro';
import ProductGrid from '../components/blocks/ProductGrid.astro';
import Gallery from '../components/blocks/Gallery.astro';
import Testimonials from '../components/blocks/Testimonials.astro';
import FAQ from '../components/blocks/FAQ.astro';
import Pricing from '../components/blocks/Pricing.astro';
import Contact from '../components/blocks/Contact.astro';
import Appointment from '../components/blocks/Appointment.astro';
import Info from '../components/blocks/Info.astro';
import Footer from '../components/blocks/Footer.astro';

// Routes statiques générées au build (SSG) : une par page du CMS. La langue par défaut
// est servie à la racine, les autres sous /<langue>/ (règle partagée avec le serveur,
// lib/i18n.mjs). Contenu lu une seule fois par build (lib/content.ts) ; en build
// orchestré, une API injoignable fait échouer le build.
export async function getStaticPaths() {
  const { pages, locales, navByLocale } = await getSiteContent();

  // Par langue : première page contenant un formulaire de contact / de prise de RDV
  // (cible des boutons d'action des pages qui n'en ont pas).
  const formPagesByLocale: Record<string, FormPages> = {};
  for (const p of pages) {
    const forms = (formPagesByLocale[p.locale || DEFAULT_LOCALE] ||= {});
    for (const b of p.layout) {
      if (b.blockType === 'contact') forms.contact ||= p.slug;
      if (b.blockType === 'appointment') forms.appointment ||= p.slug;
    }
  }

  return pages.map((page) => {
    const locale = page.locale || DEFAULT_LOCALE;
    const param = localeRouteParam(locale, page.slug);
    return {
      params: { slug: param === '' ? undefined : param },
      props: { page, nav: navByLocale[locale] || [], locale, locales, formPages: formPagesByLocale[locale] || {} },
    };
  });
}

interface FormPages {
  contact?: string;
  appointment?: string;
}

interface Props {
  page: PageDoc;
  nav: NavPage[];
  locale: string;
  locales: string[];
  formPages: FormPages;
}

const { page, nav = [], locale = DEFAULT_LOCALE, locales = [], formPages = {} } = Astro.props;
const layout: Block[] = page.layout || [];

// Mapping des types de blocs vers les composants Astro correspondants
const blockMap: Record<string, any> = {
  'hero': Hero,
  'features': Features,
  'product-grid': ProductGrid,
  'gallery': Gallery,
  'testimonials': Testimonials,
  'faq': FAQ,
  'pricing': Pricing,
  'contact': Contact,
  'appointment': Appointment,
  'info': Info,
  'footer': Footer,
};

// Bloc inconnu (type ajouté au CMS mais pas encore au template) : signalé dans le
// journal de build ; encadré visible uniquement en brouillon, rien sur le site publié.
for (const block of layout) {
  if (!blockMap[block.blockType]) {
    console.warn(`[contenu] Bloc inconnu « ${block.blockType} » ignoré (page « ${page.title} », ${localePath(locale, page.slug)}).`);
  }
}

// Ancres stables des formulaires : #contact et #rendez-vous (suffixées -2, -3… si la
// page en contient plusieurs, pour garder des id uniques).
const ANCHORS: Record<string, string> = { contact: 'contact', appointment: 'rendez-vous' };
const anchorCounts: Record<string, number> = {};
const anchorIds = layout.map((block) => {
  const base = ANCHORS[block.blockType];
  if (!base) return undefined;
  anchorCounts[base] = (anchorCounts[base] || 0) + 1;
  return anchorCounts[base] === 1 ? base : `${base}-${anchorCounts[base]}`;
});

// Cible des boutons d'action (Hero, formules, produits) : aucun champ de lien côté CMS,
// on vise donc un formulaire — celui de la page en priorité, sinon celui d'une autre
// page de la même langue (lien préfixé par le chemin de base). La prise de RDV est
// choisie si le libellé l'évoque (ou s'il n'y a qu'elle), sinon le contact. Sans
// formulaire : pas de bouton (jamais de lien mort « # »).
const APPOINTMENT_WORDS = /rendez|rdv|r[ée]serv|book|appointment/i;
const hasBlock = (type: string) => layout.some((b) => b.blockType === type);
const otherPage = (slug: string | undefined, anchor: string) => (slug ? `${withBase(localePath(locale, slug))}${anchor}` : null);
const pickForm = (contact: string | null, appointment: string | null, label?: string) =>
  appointment && (!contact || APPOINTMENT_WORDS.test(label || '')) ? appointment : contact;
const ctaTarget = (label?: string): string | null =>
  pickForm(hasBlock('contact') ? '#contact' : null, hasBlock('appointment') ? '#rendez-vous' : null, label) ||
  pickForm(otherPage(formPages.contact, '#contact'), otherPage(formPages.appointment, '#rendez-vous'), label);

// Données structurées de la page : un seul LocalBusiness (premier bloc Infos, @id
// stable) et une seule FAQPage (toutes les FAQ de la page regroupées).
const siteName = process.env.PUBLIC_SITE_NAME || '';
const siteUrl = (process.env.PUBLIC_SITE_URL || '').replace(/\/+$/, '');
const info = layout.find((b) => b.blockType === 'info');
const faqItems = layout.filter((b) => b.blockType === 'faq').flatMap((b) => (Array.isArray(b.items) ? b.items : []));
const jsonLd = [localBusinessLd(siteName, siteUrl, info), faqPageLd(faqItems)].filter(Boolean);

// Image de partage (og:image) : fond du premier Hero qui en a un.
const heroImage = layout
  .filter((b) => b.blockType === 'hero')
  .map((b) => safeHttpUrl(b.backgroundImage))
  .find(Boolean);
---

<Layout
  title={page.metaTitle || page.title}
  description={page.metaDescription}
  pages={nav}
  currentSlug={page.slug}
  locale={locale}
  locales={locales}
  isHome={page.slug === 'home'}
  image={heroImage}
  jsonLd={jsonLd}
>
  <main>
    {layout.map((block, i) => {
      const Component = blockMap[block.blockType];
      if (!Component) {
        return isDraftBuild ? (
          <div class="unknown-block">
            <p>Bloc inconnu : <strong>{block.blockType}</strong> (non affiché sur le site publié)</p>
          </div>
        ) : null;
      }
      return <Component data={block} anchorId={anchorIds[i]} ctaTarget={ctaTarget} />;
    })}
  </main>
</Layout>

<style>
  .unknown-block {
    padding: 30px;
    background-color: #fee2e2;
    border: 1px dashed #ef4444;
    color: #b91c1c;
    text-align: center;
    margin: 20px;
    border-radius: var(--border-radius);
  }
</style>
