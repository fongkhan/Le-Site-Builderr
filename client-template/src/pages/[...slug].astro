---
import Layout from '../layouts/Layout.astro';
import { normalizeLocale, localeRouteParam, localesInPages, DEFAULT_LOCALE } from '../lib/i18n.mjs';
import Hero from '../components/blocks/Hero.astro';
import Features from '../components/blocks/Features.astro';
import ProductGrid from '../components/blocks/ProductGrid.astro';
import Gallery from '../components/blocks/Gallery.astro';
import Testimonials from '../components/blocks/Testimonials.astro';
import FAQ from '../components/blocks/FAQ.astro';
import Pricing from '../components/blocks/Pricing.astro';
import Contact from '../components/blocks/Contact.astro';
import Appointment from '../components/blocks/Appointment.astro';
import Info from '../components/blocks/Info.astro';
import Footer from '../components/blocks/Footer.astro';

// Récupération des routes statiques lors de la génération (SSG).
// L'API est protégée : le webhook de build fournit ACTIVE_SITE_SLUG et BUILD_TOKEN via l'environnement.
export async function getStaticPaths() {
  try {
    const baseUrl = process.env.ORCHESTRATOR_URL || 'http://127.0.0.1:4000';
    const siteSlug = process.env.ACTIVE_SITE_SLUG || '';
    const response = await fetch(`${baseUrl}/internal/site-pages?site=${encodeURIComponent(siteSlug)}`, {
      headers: { 'x-build-token': process.env.BUILD_TOKEN || '' }
    });
    if (!response.ok) {
      throw new Error(`HTTP error! status: ${response.status}`);
    }
    const data = await response.json();

    // Langues réellement présentes : la langue par défaut est servie à la racine,
    // les autres sous /<locale>/ (voir lib/i18n.mjs, règle partagée avec le serveur).
    const locales = localesInPages(data.docs);

    // Menu de navigation PAR LANGUE : une page n'apparaît que dans sa propre langue.
    const navByLocale: Record<string, { title: string; slug: string }[]> = {};
    for (const p of data.docs as any[]) {
      const loc = normalizeLocale(p.locale);
      (navByLocale[loc] ||= []).push({ title: p.title, slug: p.slug });
    }

    // Ajoute une entrée « Actualités » au menu si le blog contient des articles publiés
    // (le blog n'est pas localisé : il reste rattaché à la langue par défaut).
    try {
      const postsRes = await fetch(`${baseUrl}/internal/site-posts?site=${encodeURIComponent(siteSlug)}`, {
        headers: { 'x-build-token': process.env.BUILD_TOKEN || '' }
      });
      if (postsRes.ok) {
        const postsData = await postsRes.json();
        if ((postsData.docs || []).length > 0) {
          (navByLocale[DEFAULT_LOCALE] ||= []).push({ title: 'Actualités', slug: 'blog' });
        }
      }
    } catch { /* blog optionnel : ignorer en cas d'erreur */ }

    return data.docs.map((page: any) => {
      const locale = normalizeLocale(page.locale);
      const param = localeRouteParam(locale, page.slug);
      return {
        params: { slug: param === '' ? undefined : param },
        props: { page, allPages: navByLocale[locale] || [], locale, locales },
      };
    });
  } catch (error: any) {
    console.error("Erreur lors de la récupération des pages depuis l'API :", error.message);
    
    // Page de fallback si l'API est injoignable pendant la phase de build
    return [
      {
        params: { slug: undefined },
        props: {
          page: {
            title: "Accueil (Mode Hors-ligne)",
            layout: [
              {
                blockType: "hero",
                title: "Meta-Builder de Sites",
                subtitle: "Le serveur local de l'Orchestrateur (port 4000) semble hors-ligne. Lancez-le pour charger vos blocs dynamiques !",
                ctaText: "En savoir plus"
              }
            ]
          }
        }
      }
    ];
  }
}

const { page, allPages = [], locale = DEFAULT_LOCALE, locales = [] } = Astro.props;

// Mapping des types de blocs vers les composants Astro correspondants
const blockMap: Record<string, any> = {
  'hero': Hero,
  'features': Features,
  'product-grid': ProductGrid,
  'gallery': Gallery,
  'testimonials': Testimonials,
  'faq': FAQ,
  'pricing': Pricing,
  'contact': Contact,
  'appointment': Appointment,
  'info': Info,
  'footer': Footer
};
---

<Layout
  title={page.metaTitle || page.title}
  description={page.metaDescription}
  pages={allPages}
  currentSlug={page.slug}
  locale={locale}
  locales={locales}
>
  <main>
    {page.layout && page.layout.map((block: any) => {
      const Component = blockMap[block.blockType];
      if (!Component) {
        return (
          <div class="unknown-block">
            <p>Bloc inconnu : <strong>{block.blockType}</strong></p>
          </div>
        );
      }
      return <Component data={block} />;
    })}
  </main>
</Layout>

<style>
  .unknown-block {
    padding: 30px;
    background-color: #fee2e2;
    border: 1px dashed #ef4444;
    color: #b91c1c;
    text-align: center;
    margin: 20px;
    border-radius: var(--border-radius);
  }
</style>
