---
import { safeHttpUrl, safeMailto, safeTel } from '../../lib/url';

interface Props {
  data: {
    title?: string;
    address?: string;
    phone?: string;
    email?: string;
    hours?: string;
    googleBusinessUrl?: string;
  };
}

const { data } = Astro.props;

// Liens construits depuis des saisies du client : fiche Google en http(s) uniquement,
// téléphone réduit aux chiffres, email plausible. Une valeur refusée est affichée
// sans lien (ou ignorée pour la fiche Google).
const googleUrl = safeHttpUrl(data.googleBusinessUrl, { relative: false });
const telHref = safeTel(data.phone);
const mailHref = safeMailto(data.email);

// Les données structurées LocalBusiness sont émises une seule fois par la page
// (premier bloc Infos, @id stable : voir lib/jsonld.ts) et non par chaque bloc.
---

<section class="info-section">
  <div class="container">
    <h2>{data.title || 'Infos pratiques'}</h2>
    <div class="info-card">
      {data.address && <div class="info-row"><span class="info-icon" aria-hidden="true">📍</span><span class="info-multiline">{data.address}</span></div>}
      {data.phone && <div class="info-row"><span class="info-icon" aria-hidden="true">📞</span>{telHref ? <a href={telHref}>{data.phone}</a> : <span>{data.phone}</span>}</div>}
      {data.email && <div class="info-row"><span class="info-icon" aria-hidden="true">✉️</span>{mailHref ? <a href={mailHref}>{data.email}</a> : <span>{data.email}</span>}</div>}
      {data.hours && <div class="info-row"><span class="info-icon" aria-hidden="true">🕒</span><span class="info-hours">{data.hours}</span></div>}
      {googleUrl && <div class="info-row"><span class="info-icon" aria-hidden="true">⭐</span><a href={googleUrl} target="_blank" rel="noopener noreferrer">Voir notre fiche Google</a></div>}
    </div>
  </div>
</section>

<style>
  .info-section {
    padding: 80px 20px;
    background-color: var(--color-bg);
  }

  .container {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
  }

  .info-section h2 {
    font-size: 2.5rem;
    margin-bottom: 40px;
  }

  .info-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 30px;
    border-radius: var(--border-radius);
    background-color: color-mix(in srgb, var(--color-secondary) 30%, transparent);
    text-align: left;
  }

  .info-row {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 1.05rem;
  }

  .info-icon {
    font-size: 1.2rem;
    flex-shrink: 0;
  }

  .info-hours,
  .info-multiline {
    white-space: pre-line;
  }

  .info-card a {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 600;
  }
</style>
