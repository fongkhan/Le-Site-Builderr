---
// Bloc « Prise de rendez-vous » : la demande réutilise l'endpoint de contact (message
// composé côté client : prestation + créneau + téléphone) puis est envoyée aux
// propriétaires du site par email. Balisage, styles et envoi communs : LeadForm.astro.
// Ancre stable #rendez-vous : cible des CTA de la page.
import LeadForm from '../forms/LeadForm.astro';
import { t } from '../../lib/ui-strings.mjs';

interface Props {
  data: {
    title?: string;
    subtitle?: string;
    ctaText?: string;
    services?: { name?: string }[];
  };
  /** id d'ancre attribué par la page (unique : « rendez-vous », « rendez-vous-2 »…). */
  anchorId?: string;
  /** Langue de la page (libellés d'interface, lib/ui-strings.mjs). */
  locale?: string;
}

const { data, anchorId = 'rendez-vous', locale } = Astro.props;
const services = (data.services || []).map((s) => s?.name).filter(Boolean) as string[];
---

<LeadForm
  kind="appointment"
  anchorId={anchorId}
  title={data.title || t(locale, 'appointmentTitle')}
  subtitle={data.subtitle}
  ctaText={data.ctaText || t(locale, 'appointmentCta')}
  locale={locale}
  services={services}
/>
