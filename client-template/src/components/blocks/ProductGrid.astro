---
import { safeHttpUrl } from '../../lib/url';
import type { CtaLink } from '../../lib/url';
import { t } from '../../lib/ui-strings.mjs';
import { getSiteContent } from '../../lib/content';
import { siteImage } from '../../lib/images';

interface ProductItem {
  name?: string;
  price?: string;
  image?: string;
  /** Lien du bouton « Commander » (vide : formulaire du site, mode Automatique). */
  ctaLink?: string | null;
}

interface Props {
  data: {
    title?: string;
    products?: ProductItem[];
  };
  /** Lien d'un bouton : lien saisi s'il est valide, sinon formulaire selon le libellé ; null : pas de bouton. */
  resolveCta?: (link: unknown, label?: string) => CtaLink | null;
  /** Langue de la page (libellés d'interface, lib/ui-strings.mjs). */
  locale?: string;
}

const { data, resolveCta, locale } = Astro.props;
const { media } = await getSiteContent();
// Bouton « Commander » : lien du produit s'il est valide, sinon formulaire de la page
// (mode Automatique, cible choisie sur le libellé français ; seul le texte affiché est
// traduit). Image : texte alternatif de la médiathèque, sinon le nom du produit.
const products = (data.products || []).filter(Boolean).map((p) => {
  const src = safeHttpUrl(p.image);
  return {
    ...p,
    image: src ? siteImage(src, media, { fallbackAlt: p.name || '', sizes: '(max-width: 640px) calc(100vw - 40px), 380px' }) : null,
    cta: resolveCta ? resolveCta(p.ctaLink, 'Commander') : null,
  };
});
---

<section class="products-section">
  <div class="container">
    {data.title && <h2 class="section-title">{data.title}</h2>}
    <div class="products-grid">
      {products.map((product) => (
        <div class="product-card">
          <div class="product-image-container">
            {product.image && (
              <img src={product.image.src} alt={product.image.alt} width={product.image.width} height={product.image.height} srcset={product.image.srcset} sizes={product.image.sizes} loading="lazy" decoding="async" />
            )}
          </div>
          <div class="product-info">
            {product.name && <h3>{product.name}</h3>}
            {product.price && <span class="price">{product.price}</span>}
            {product.cta && (
              <a
                class="buy-button"
                href={product.cta.href}
                target={product.cta.newTab ? '_blank' : undefined}
                rel={product.cta.newTab ? 'noopener noreferrer' : undefined}
                aria-label={product.name ? `${t(locale, 'orderProduct', { name: product.name })}${product.cta.newTab ? ` ${t(locale, 'newTab')}` : ''}` : undefined}
              >
                {t(locale, 'order')}{!product.name && product.cta.newTab && <span class="visually-hidden"> {t(locale, 'newTab')}</span>}
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .products-section {
    padding: 80px 20px;
    background-color: var(--color-secondary);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }


  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
  }

  .product-card {
    background: #ffffff;
    border-radius: var(--border-radius);
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  }

  .product-image-container {
    height: 250px;
    overflow: hidden;
    position: relative;
    background-color: #eee;
  }

  .product-image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .product-card:hover .product-image-container img {
    transform: scale(1.08);
  }

  .product-info {
    padding: 25px;
    text-align: left;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .product-info h3 {
    font-size: 1.25rem;
    margin-bottom: 10px;
    color: var(--color-text);
  }

  .price {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 20px;
    font-family: var(--font-heading), serif;
  }

  .buy-button {
    display: block;
    text-decoration: none;
    margin-top: auto;
    padding: 10px 20px;
    background-color: var(--color-primary);
    color: #ffffff;
    border: none;
    border-radius: var(--border-radius);
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease;
    width: 100%;
    text-align: center;
  }

  .buy-button:hover {
    filter: brightness(1.1);
  }
</style>
