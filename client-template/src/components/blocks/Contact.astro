---
interface Props {
  data: {
    title?: string;
    subtitle?: string;
    ctaText?: string;
  };
}

const { data } = Astro.props;

// Slug injecté au build ; l'API de contact est servie par l'orchestrateur.
// PUBLIC_API_BASE permet de pointer vers l'hôte de l'API en production (vide = même
// origine, cas de l'aperçu /preview servi par l'orchestrateur).
const slug = process.env.ACTIVE_SITE_SLUG || '';
const apiBase = process.env.PUBLIC_API_BASE || '';
const action = `${apiBase}/api/contact/${slug}`;
---

<section class="contact-section">
  <div class="container">
    <h2>{data.title || 'Contactez-nous'}</h2>
    {data.subtitle && <p class="contact-intro">{data.subtitle}</p>}

    <form class="contact-form" data-action={action}>
      <input type="text" name="name" placeholder="Votre nom" required maxlength="120" />
      <input type="email" name="email" placeholder="Votre email" required maxlength="200" />
      <textarea name="message" placeholder="Votre message…" required rows="4" maxlength="5000"></textarea>
      <!-- Champ anti-robot : caché aux humains, rempli seulement par les bots -->
      <input type="text" name="company" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <button type="submit">{data.ctaText || 'Envoyer le message'}</button>
      <p class="contact-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  // Envoi en fetch (progressive enhancement) : échoue en douceur, ne casse jamais la page.
  document.querySelectorAll('.contact-form').forEach((formEl) => {
    const form = formEl as HTMLFormElement;
    const status = form.querySelector('.contact-status') as HTMLElement;
    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const action = form.dataset.action || '';
      const payload = {
        name: (form.elements.namedItem('name') as HTMLInputElement).value,
        email: (form.elements.namedItem('email') as HTMLInputElement).value,
        message: (form.elements.namedItem('message') as HTMLTextAreaElement).value,
        company: (form.elements.namedItem('company') as HTMLInputElement).value,
      };
      button.disabled = true;
      status.textContent = 'Envoi en cours…';
      try {
        const res = await fetch(action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (res.ok) {
          form.reset();
          status.textContent = 'Merci, votre message a bien été envoyé !';
        } else {
          const data = await res.json().catch(() => ({}));
          status.textContent = data.error || "Une erreur est survenue. Réessayez plus tard.";
        }
      } catch {
        status.textContent = "Impossible d'envoyer le message pour le moment.";
      } finally {
        button.disabled = false;
      }
    });
  });
</script>

<style>
  .contact-section {
    padding: 80px 20px;
    background-color: var(--color-bg);
  }

  .container {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
  }

  .contact-section h2 {
    font-size: 2.5rem;
    margin-bottom: 15px;
  }

  .contact-intro {
    opacity: 0.85;
    margin-bottom: 30px;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-align: left;
  }

  .contact-form input,
  .contact-form textarea {
    padding: 12px 14px;
    border: 1px solid color-mix(in srgb, var(--color-text) 20%, transparent);
    border-radius: var(--border-radius);
    font-family: var(--font-body), sans-serif;
    font-size: 1rem;
    background-color: #fff;
    color: #111;
  }

  /* Honeypot : invisible pour les humains */
  .hp-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .contact-form button {
    background-color: var(--color-primary);
    color: #fff;
    border: none;
    border-radius: var(--border-radius);
    padding: 12px 20px;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .contact-form button:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .contact-status {
    min-height: 1.2em;
    font-size: 0.9rem;
    margin: 0;
  }
</style>
