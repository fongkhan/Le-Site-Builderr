---
import { safeHttpUrl } from '../../lib/url';
import { getSiteContent } from '../../lib/content';
import { siteImage } from '../../lib/images';

interface Props {
  data: {
    title?: string;
    // Chaînes (canal interne) ou { url } (forme Payload brute)
    images?: (string | { url?: string } | null)[];
  };
}

const { data } = Astro.props;
const { media } = await getSiteContent();

// URLs filtrées (http(s) ou médias du site). Texte alternatif : celui de la médiathèque,
// sinon repli descriptif « Photo N – <titre de la galerie> ». Dimensions et variantes
// (srcset) pour les images de la médiathèque.
const altFor = (index: number) => (data.title ? `Photo ${index + 1} – ${data.title}` : `Photo ${index + 1}`);
const images = (data.images || [])
  .map((img) => safeHttpUrl(typeof img === 'string' ? img : img?.url))
  .filter(Boolean)
  .map((src, index) => siteImage(src, media, { fallbackAlt: altFor(index), sizes: '(max-width: 640px) calc(100vw - 40px), 400px' }));
---

<section class="gallery-section">
  <div class="container">
    {data.title && <h2 class="section-title">{data.title}</h2>}
    <div class="gallery-grid">
      {images.map((img) => (
        <div class="gallery-item">
          <img src={img.src} alt={img.alt} width={img.width} height={img.height} srcset={img.srcset} sizes={img.sizes} loading="lazy" decoding="async" />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery-section {
    padding: 80px 20px;
    background-color: var(--color-bg);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }


  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
  }

  .gallery-item {
    height: 250px;
    overflow: hidden;
    border-radius: var(--border-radius);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
    transition: transform 0.3s ease;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .gallery-item:hover {
    transform: scale(1.03);
  }

  .gallery-item:hover img {
    transform: scale(1.05);
  }
</style>
