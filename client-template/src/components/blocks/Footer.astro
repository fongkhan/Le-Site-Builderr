---
import { safeHttpUrl } from '../../lib/url';
import { t } from '../../lib/ui-strings.mjs';

interface Props {
  data: {
    text?: string;
    socials?: { facebook?: string; instagram?: string; linkedin?: string; x?: string };
  };
  /** Langue de la page (libellés d'interface, lib/ui-strings.mjs). */
  locale?: string;
}

const { data, locale } = Astro.props;
const LABELS: Record<string, string> = { facebook: 'Facebook', instagram: 'Instagram', linkedin: 'LinkedIn', x: 'X' };
// URLs saisies par le client : http(s) uniquement (un « javascript: » serait une XSS
// stockée). Une URL refusée est simplement ignorée.
const socials = Object.entries(data.socials || {})
  .filter(([network]) => Object.hasOwn(LABELS, network))
  .map(([network, url]) => [network, safeHttpUrl(url, { relative: false })] as const)
  .filter(([, url]) => Boolean(url));
---

<footer class="site-footer">
  <div class="container">
    {data.text && <p class="footer-text">{data.text}</p>}
    {socials.length > 0 && (
      <nav class="footer-socials" aria-label={t(locale, 'socialLinks')}>
        {socials.map(([network, url]) => (
          <a href={url} target="_blank" rel="noopener noreferrer">{LABELS[network] || network}</a>
        ))}
      </nav>
    )}
  </div>
</footer>

<style>
  .site-footer {
    padding: 30px 20px;
    border-top: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
    background-color: var(--color-bg);
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .footer-text {
    opacity: 0.8;
    font-size: 0.95rem;
    margin-bottom: 10px;
  }

  .footer-socials {
    display: flex;
    gap: 18px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .footer-socials a {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: none;
    font-size: 0.95rem;
  }
</style>
