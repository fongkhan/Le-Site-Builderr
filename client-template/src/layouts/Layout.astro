---
import '../styles/base.css';
import '../styles/theme.css';


interface NavPage {
	title: string;
	slug: string;
}

interface Props {
	title?: string;
	description?: string;
	pages?: NavPage[];
	currentSlug?: string;
}

const { title = "Mon Site Composable", description, pages = [], currentSlug } = Astro.props;
// La page « home » vit à la racine ; les autres sous /<slug>/
const pageHref = (slug: string) => (slug === 'home' ? '/' : `/${slug}/`);

// Beacon de statistiques (anonyme) : injecté au build. Vide si le site est construit
// hors contexte (template autonome) → aucun script émis.
const statsSlug = process.env.ACTIVE_SITE_SLUG || '';
const statsApiBase = process.env.PUBLIC_API_BASE || '';
const beaconUrl = statsSlug ? `${statsApiBase}/api/stats/hit/${statsSlug}` : '';
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		
		<!-- Google Fonts pré-chargées pour correspondre aux palettes IA -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Inter:wght@300;400;600;700&family=Lora:ital,wght@0,400;0,700;1,400&family=Outfit:wght@400;600;800&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Space+Grotesk:wght@400;500;700&family=Plus+Jakarta+Sans:wght@400;600;700&family=Karla:wght@400;700&display=swap" rel="stylesheet">
	</head>
	<body>
		{pages.length > 1 && (
			<nav class="site-nav">
				{pages.map((p) => (
					<a href={pageHref(p.slug)} class={p.slug === currentSlug ? 'active' : ''}>{p.title}</a>
				))}
			</nav>
		)}
		<slot />
		{beaconUrl && (
			<script define:vars={{ beaconUrl }}>
				// Statistique de visite anonyme : une page vue = un envoi, sans cookie ni
				// donnée personnelle. Chargé après le rendu, échoue en silence : ne casse
				// jamais la page publiée.
				try {
					if (navigator.sendBeacon) {
						navigator.sendBeacon(beaconUrl);
					} else {
						fetch(beaconUrl, { method: 'POST', keepalive: true }).catch(() => {});
					}
				} catch (e) { /* ignoré volontairement */ }
			</script>
		)}
	</body>
</html>

<style is:global>
	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	body {
		background-color: var(--color-bg);
		color: var(--color-text);
		font-family: var(--font-body), sans-serif;
		line-height: 1.6;
		transition: background-color 0.3s ease, color 0.3s ease;
	}

	h1, h2, h3, h4, h5, h6 {
		font-family: var(--font-heading), serif;
		font-weight: 700;
		line-height: 1.2;
		color: var(--color-text);
	}

	/* Menu de navigation multi-pages (affiché seulement si le site a plusieurs pages) */
	.site-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 4px;
		padding: 12px 20px;
		background-color: var(--color-bg);
		border-bottom: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
	}

	.site-nav a {
		color: var(--color-text);
		text-decoration: none;
		font-family: var(--font-body), sans-serif;
		font-weight: 600;
		font-size: 0.95rem;
		padding: 6px 14px;
		border-radius: var(--border-radius);
		transition: background-color 0.2s ease;
	}

	.site-nav a:hover {
		background-color: color-mix(in srgb, var(--color-primary) 12%, transparent);
	}

	.site-nav a.active {
		background-color: var(--color-primary);
		color: #ffffff;
	}
</style>
